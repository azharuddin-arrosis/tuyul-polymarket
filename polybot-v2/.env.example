# ============================================================
# POLYMARKET BOT v2 — ENVIRONMENT TEMPLATE
# Copy ini ke .env dan isi nilai sebenarnya
# ============================================================

# --- MODE ---
# sim  = simulasi virtual, tidak kirim order
# real = trading nyata (isi semua POLY_* dulu)
BOT_MODE=sim

# --- KAPITAL ---
USDC_CAPITAL=10
POL_BALANCE=11

# --- RISK ---
MAX_BET_USD=2.0
MIN_BET_USD=0.5
MAX_OPEN_POS=5
MIN_EV=0.05
DAILY_LOSS_LIMIT=3.0
PROB_MIN=0.60
PROB_MAX=0.85
SCAN_INTERVAL=5

# --- COMPOUND ---
# $20=T1=$1/bet, $40=T2=$2/bet, $60=T3=$3/bet, dst
COMPOUND_BASE=20
COMPOUND_STEP=20
COMPOUND_INC=1.0
COMPOUND_MAX_BET=20.0

# --- GAS ALERT ---
GAS_ALERT_TX=10    # warn kalau < 10 tx tersisa
GAS_STOP_TX=2      # auto-stop kalau < 2 tx tersisa

# --- POLYMARKET API (isi saat MODE=real) ---
POLY_PRIVATE_KEY=
POLY_API_KEY=
POLY_SECRET=
POLY_PASSPHRASE=