# ============================================================
# POLYMARKET BOT v2 — BOT 2 (Secondary) - REAL MODE
# Environment configuration for bot2-real instance
# ============================================================

# --- BOT ID ---
BOT_NAME=bot2-real
BOT_DISPLAY_NAME=Secondary Bot (Real)
BOT_COLOR=#ff6600

# --- MODE ---
# sim  = simulasi virtual, tidak kirim order
# real = trading nyata (isi semua POLY_* dulu)
BOT_MODE=real

# --- BOTS CONFIG ---
BOTS=bot1,bot2

# --- KAPITAL ---
# Lower capital for real mode - start small!
USDC_CAPITAL=20
POL_BALANCE=22

# --- RISK ---
MAX_BET_USD=3.0
MIN_BET_USD=1.0
MAX_OPEN_POS=3
MIN_EV=0.06
DAILY_LOSS_LIMIT=5.0
PROB_MIN=0.65
PROB_MAX=0.82
SCAN_INTERVAL=8

# --- COMPOUND ---
COMPOUND_DIVISOR=10.0
COMPOUND_MIN_BET=1.0
COMPOUND_MAX_CAP=20.0

# --- GAS ALERT ---
GAS_ALERT_TX=15
GAS_STOP_TX=3

# --- POLYMARKET API ---
# ENCRYPTED: sensitive fields stored encrypted
POLY_PRIVATE_KEY=enc:gAAAAAAA... (encrypted)
POLY_API_KEY=enc:AAAAAAAA...
POLY_SECRET=enc:BBBBBBBB...
POLY_PASSPHRASE=enc:CCCCCCCC...