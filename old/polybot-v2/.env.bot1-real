# ============================================================
# POLYMARKET BOT v2 — BOT 1 (Primary) - REAL MODE
# Environment configuration for bot1-real instance
# ============================================================

# --- BOT ID ---
BOT_NAME=bot1-real
BOT_DISPLAY_NAME=Primary Bot (Real)
BOT_COLOR=#00ff88

# --- MODE ---
# sim  = simulasi virtual, tidak kirim order
# real = trading nyata (isi semua POLY_* dulu)
BOT_MODE=real

# --- BOTS CONFIG ---
BOTS=bot1,bot2

# --- KAPITAL ---
# Lower capital for real mode - start small!
USDC_CAPITAL=10
POL_BALANCE=11

# --- RISK ---
MAX_BET_USD=2.0
MIN_BET_USD=0.5
MAX_OPEN_POS=5
MIN_EV=0.05
DAILY_LOSS_LIMIT=3.0
PROB_MIN=0.60
PROB_MAX=0.85
SCAN_INTERVAL=5

# --- COMPOUND ---
COMPOUND_DIVISOR=10.0
COMPOUND_MIN_BET=1.0
COMPOUND_MAX_CAP=20.0

# --- GAS ALERT ---
GAS_ALERT_TX=10
GAS_STOP_TX=2

# --- POLYMARKET API ---
# ENCRYPTED: sensitive fields stored encrypted
POLY_PRIVATE_KEY=enc:gAAAAAAA... (encrypted)
POLY_API_KEY=enc:AAAAAAAA...
POLY_SECRET=enc:BBBBBBBB...
POLY_PASSPHRASE=enc:CCCCCCCC...